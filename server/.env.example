# ============================================================
# NEXPULSE AI — Server Environment Configuration
# ============================================================
# Copy this file to `.env` for local development.
# For production, set these as environment variables on Render.
# NEVER commit `.env` to version control.
# ============================================================

##############################################################
# APPLICATION
##############################################################
NODE_ENV=development
PORT=4000

APP_NAME=NEXPULSE AI
# In production: https://nexpulse-api.onrender.com
APP_URL=http://localhost:4000
# In production: https://nexpulse.vercel.app
CLIENT_URL=http://localhost:5174

##############################################################
# DATABASE
##############################################################
# In production: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/nexpulse?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/nexpulse

##############################################################
# JWT
##############################################################
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_64_character_random_secret

JWT_ACCESS_EXPIRES_IN=15m

##############################################################
# COOKIES
##############################################################
# Generate with: openssl rand -hex 32
COOKIE_SECRET=replace_with_cookie_secret

# In production: true (HTTPS). Dev default: false
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Generate with: openssl rand -hex 32. Required in production for MFA secrets.
IDENTITY_ENCRYPTION_KEY=
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_MAX_DAYS=30
TRUSTED_DEVICE_DAYS=30
JWT_ISSUER=nexpulse-api
JWT_AUDIENCE=nexpulse-web

##############################################################
# CORS
##############################################################
# In production: https://nexpulse.vercel.app
# Comma-separated for multiple origins
CORS_ORIGIN=http://localhost:5174

##############################################################
# CLOUDINARY (Optional)
##############################################################
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

##############################################################
# REDIS / BACKGROUND JOB QUEUE
##############################################################
# Backs webhook delivery, security threat/compliance jobs, and queued verification/
# reset emails (BullMQ). `docker-compose up` provides a local Redis on this default.
REDIS_URL=redis://127.0.0.1:6379
# Set to false to disable background job processing entirely (webhooks, security jobs,
# and queued email become no-ops rather than attempting to reach Redis).
ENABLE_QUEUES=true

##############################################################
# AI PROVIDERS
##############################################################
# In production: set at least one API key and change DEFAULT_AI_PROVIDER
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

DEFAULT_AI_PROVIDER=auto

##############################################################
# SOCIAL OAUTH
##############################################################
# Generate a 32-byte key: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_SESSION_TTL_MINUTES=15

# Register every callback as:
# {APP_URL}/api/v1/platforms/oauth/{provider}/callback
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v23.0

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202607
LINKEDIN_OAUTH_SCOPES=openid profile w_member_social r_organization_social rw_organization_admin

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

##############################################################
# EMAIL (Future)
##############################################################
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

##############################################################
# RAZORPAY SUBSCRIPTION BILLING
##############################################################
# Keep disabled until the matching test or live credentials, webhook secret,
# and both Razorpay plan IDs are configured.
ENABLE_BILLING=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Use a dedicated random secret configured in the Razorpay Dashboard webhook.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PROFESSIONAL_MONTHLY_PLAN_ID=
RAZORPAY_PROFESSIONAL_ANNUAL_PLAN_ID=
RAZORPAY_CURRENCY=INR
# Minor currency units: 399900 = INR 3,999.00
RAZORPAY_PROFESSIONAL_MONTHLY_PRICE_MINOR=399900
# Annual total: INR 38,388.00 (INR 3,199/month equivalent)
RAZORPAY_PROFESSIONAL_ANNUAL_PRICE_MINOR=3838800

##############################################################
# RATE LIMIT
##############################################################
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

##############################################################
# LOGGING
##############################################################
LOG_LEVEL=info

##############################################################
# OPERATIONS
##############################################################
METRICS_ENABLED=true
OPERATIONS_MONITOR_ENABLED=true
# Optional HTTPS endpoint for degraded/not-ready state notifications.
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_CHECK_INTERVAL_MS=300000
OPERATIONS_ALERT_COOLDOWN_MS=1800000

##############################################################
# FEATURE FLAGS
##############################################################
ENABLE_AI=true
ENABLE_PLATFORM_SYNC=true
ENABLE_EMAIL=false
ENABLE_ANALYTICS=true

##############################################################
# SECURITY
##############################################################
BCRYPT_ROUNDS=12
# In production: automatically set to true
TRUST_PROXY=false

##############################################################
# DEPLOYMENT
##############################################################
RENDER_EXTERNAL_URL=
VERCEL_URL=

##############################################################
# VERSION
##############################################################
API_VERSION=v1
