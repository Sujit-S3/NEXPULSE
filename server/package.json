{
  "name": "nexpulse-ai-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "rimraf dist",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "lint:fix": "eslint . --ext .ts --fix",
    "migrate:platform-oauth": "tsx src/scripts/migratePlatformOAuth.ts",
    "migrate:identity": "tsx src/scripts/migrateIdentityPlatform.ts",
    "migrate:developer-platform": "tsx src/scripts/migrateDeveloperPlatform.ts",
    "migrate:security-platform": "tsx src/scripts/migrateSecurityPlatform.ts",
    "migrate:billing-platform": "tsx src/scripts/migrateBillingPlatform.ts",
    "config:validate": "tsx src/scripts/validateRuntimeConfig.ts",
    "config:validate:strict": "tsx src/scripts/validateRuntimeConfig.ts --strict",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@bull-board/api": "^8.5.0",
    "@bull-board/express": "^8.5.0",
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "body-parser": "1.20.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.9"
  }
}
